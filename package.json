{
  "name": "assay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n engine,web -c yellow,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "test": "tsx --test server/*.test.ts server/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:engine": "./scripts/build-engine.sh",
    "app": "vite build && ./scripts/build-engine.sh && tauri build --bundles app",
    "build:mcp": "esbuild server/mcp.ts --bundle --platform=node --format=esm --target=node20 --outfile=build/assay-mcp.mjs --log-level=warning"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "lucide-react": "^1.60.0",
    "plist": "^5.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/plist": "^3.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
