{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Assay",
  "version": "0.1.0",
  "identifier": "com.allstreets.assay",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Assay",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 640,
        "theme": "Dark",
        "backgroundColor": "#121110",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "copyright": "AllStreets",
    "shortDescription": "A bill of materials for your whole Mac",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": ["binaries/assay-engine"],
    "resources": {
      "../dist/": "dist/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "Teardown Local Signing",
      "hardenedRuntime": false
    }
  }
}
